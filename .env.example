# This file configures the Sepolia bot only. BNB settings live in ignored .env.bnb.local.
NETWORK=sepolia
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
EXECUTOR_KEY=
FB_REPUTATION_KEY=
BUY_PAIR_ADDRESS=
SELL_PAIR_ADDRESS=
# Optional 2-4 hop V2 cycle. When set, these replace BUY_PAIR_ADDRESS/SELL_PAIR_ADDRESS.
ROUTE_PAIRS=
ROUTE_TOKENS=
WETH_ADDRESS=0xfff9976782d46cc05630d1f6ebab18b2324d6b14
TOKEN_ADDRESS=
ARB_CONTRACT_ADDRESS=
# Optional V2/V3 mixed bot. Select one deployed mixed executor and its official V3 pool.
MIXED_ARB_CONTRACT_ADDRESS=
MIXED_V3_POOL_ADDRESS=
MIXED_DIRECTION=V3-to-V2
MIXED_GAS_LIMIT=600000
TRADE_SIZES_WETH=0.001,0.002,0.005
MIN_NET_PROFIT_WETH=0.00002
GAS_LIMIT=400000
MAX_PRIORITY_FEE_GWEI=0.1
MAX_FEE_GWEI=2
BOT_MODE=observe
DASHBOARD_PORT=8787
